# Copy this file to .env and fill in your own values. Never commit .env.

# Google AI Studio key (https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key
# Optional, default gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# The cart service (backend/demo-service)
SERVICE_URL=http://localhost:5000

# Optional: MongoDB to save investigation reports. Leave empty to skip saving.
MONGO_URI=
