# Copy this file to .env and fill in your own values. Never commit .env.

APP_VERSION=1.0.0
PORT=5000

# Which fault is active at startup: healthy | cart_down | db_down | slow
SCENARIO=healthy

# The real MongoDB database (logs and carts are stored here)
MONGO_URI=mongodb+srv://user:password@your-cluster.mongodb.net/
# A database address that doesn't exist, used by the db_down scenario
FAKEDB=mongodb+srv://user:password@your-cluster.mongodb.not/
